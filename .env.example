# Example Environment Variables Configuration for Streamlit Cloud
# Add these securely into Streamlit Cloud -> Settings -> Secrets

# (Optional) Used to enrich real-time travel boundaries with live TomTom Traffic
TOMTOM_API_KEY=your_tom_tom_key_here

# (Optional) Used to fetch live realistic traffic routes
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# (Optional) Fetches real-world climate impacts on traffic routing
OPENWEATHER_API_KEY=your_openweather_key_here

# (Optional) Quantum Execution Environment Token (if using IBM Quantum)
IBMQ_API_TOKEN=your_ibmq_token_here
